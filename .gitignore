# OS junk
.DS_Store
Thumbs.db

# Dependencies (cucumber-js is the only dev dep; engine itself has none)
node_modules/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment / secrets
.env
.env.*
!.env.example

# Test / build output
coverage/
.nyc_output/
*.tgz

# Backups & archived MVP/exploration docs (kept locally, out of the repo)
*.bak
archive/

# Internal specs & working notes (kept locally, not in the public repo or shipped product)
docs/
tmp/

# Fiberplane local issue tracking
.fp/
# fp-managed agent guide — regenerated per machine by `fp agent setup standard`
FP_AGENTS.md

# Project skills. A global excludes file ignores `.claude/` wholesale, and git
# will not descend into an excluded directory — so re-include the directory,
# re-exclude its machine-local contents (settings.json, worktrees/, locks),
# then re-include just the skills that belong to the repo.
!.claude/
.claude/*
!.claude/skills/
